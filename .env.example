# Yahoo Developer credentials (keep these private)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Yahoo documents `oob` for command-line authorization. If your Yahoo app
# requires a registered callback URL, use that exact value here instead.
YAHOO_REDIRECT_URI=oob

# Your league URL is https://football.fantasysports.yahoo.com/f1/30035
YAHOO_LEAGUE_ID=30035

# Optional. Defaults to true: a player stored in Yahoo's IR slot can still
# contribute to Max PF if he actually scores points that week.
INCLUDE_IR=true
